{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "bash|powershell|shell|execute",
        "type": "command",
        "bash": "python3 \"$HOME/.copilot/hooks/push-guard-hook.py\" || exit 0",
        "powershell": "python \"$env:USERPROFILE\\.copilot\\hooks\\push-guard-hook.py\"; exit 0",
        "timeoutSec": 10,
        "env": {
          "PUSH_GUARD_CONFIG": ""
        }
      },
      {
        "matcher": "bash|powershell|shell|execute",
        "type": "command",
        "bash": "python3 \"$HOME/.copilot/hooks/shell-guard-hook.py\" || exit 0",
        "powershell": "python \"$env:USERPROFILE\\.copilot\\hooks\\shell-guard-hook.py\"; exit 0",
        "timeoutSec": 10
      },
      {
        "matcher": "bash|powershell|shell|execute",
        "type": "command",
        "bash": "python3 \"$HOME/.copilot/hooks/slop-guard-hook.py\" || exit 0",
        "powershell": "python \"$env:USERPROFILE\\.copilot\\hooks\\slop-guard-hook.py\"; exit 0",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "python3 \"$HOME/.copilot/hooks/pr-post-gate-hook.py\" pre || exit 0",
        "powershell": "python \"$env:USERPROFILE\\.copilot\\hooks\\pr-post-gate-hook.py\" pre; exit 0",
        "timeoutSec": 30
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "python3 \"$HOME/.copilot/hooks/shell-guard-hook.py\" || exit 0",
        "powershell": "python \"$env:USERPROFILE\\.copilot\\hooks\\shell-guard-hook.py\"; exit 0",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "python3 \"$HOME/.copilot/hooks/shell-guard-hook.py\" || exit 0",
        "powershell": "python \"$env:USERPROFILE\\.copilot\\hooks\\shell-guard-hook.py\"; exit 0",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "matcher": "ask_user|bash|powershell|shell|execute",
        "type": "command",
        "bash": "python3 \"$HOME/.copilot/hooks/pr-post-gate-hook.py\" post || exit 0",
        "powershell": "python \"$env:USERPROFILE\\.copilot\\hooks\\pr-post-gate-hook.py\" post; exit 0",
        "timeoutSec": 30
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "python3 \"$HOME/.copilot/hooks/pr-post-gate-hook.py\" prompt || exit 0",
        "powershell": "python \"$env:USERPROFILE\\.copilot\\hooks\\pr-post-gate-hook.py\" prompt; exit 0",
        "timeoutSec": 10
      }
    ]
  }
}
