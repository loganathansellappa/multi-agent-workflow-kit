# Python
__pycache__/
*.pyc

# Per-user config (contains local paths) — ship the .example instead
agents/agents.config.yaml

# Secrets — never commit
.secrets/
*.token

# Local denylist for the "keep it generic" scrub scan — names live here, never in the repo
scripts/company-terms.txt

# Rollback snapshots written by sync_from_live.py — local-only, never commit
.sync-backups/

# Shell-guard runtime markers (per-session, local-only)
hooks/.readonly-sessions/
